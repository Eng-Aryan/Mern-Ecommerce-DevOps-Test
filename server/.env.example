PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce
# CHANGE THIS. Use a long random string (e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=5252525252525211212212214444
CLIENT_URL=http://localhost:5173

# --- Card payments (optional) ---
STRIPE_SECRET_KEY=
# Needed so orders are marked paid even if the customer closes the tab.
# Stripe dashboard -> Webhooks -> endpoint: https://YOUR-DOMAIN/api/payment/webhook (event: checkout.session.completed)
STRIPE_WEBHOOK_SECRET=

# --- Email (optional). Without SMTP, emails are printed in the server console instead ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Tidewater Supply <no-reply@yourdomain.com>"
# Where contact-form messages are emailed (falls back to the email in Admin > Settings)
CONTACT_TO=
